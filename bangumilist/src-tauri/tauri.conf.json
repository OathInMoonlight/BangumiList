{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bangumilist",
  "version": "0.1.0",
  "identifier": "OathInMoonlight-Bangumilist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bangumilist",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": [
          "zh-CN",
          "ja-JP",
          "en-US"
        ]
      }
    },
    "fileAssociations": [{
      "ext": ["bldb"]
    }]
  }
}
